#. Plugin Name of the plugin
#: plugins.php
msgid "Block editor customize"
msgstr ""

#. Description of the plugin
#: plugins.php
msgid "Adds extra styles to the List block and definition list (dl / dt / dd) blocks to the block editor."
msgstr "ブロックエディターのリストブロックにスタイルを追加し、定義リスト（dl / dt / dd）ブロックを追加します。"

#. Author of the plugin
#: plugins.php
msgid "shokun"
msgstr ""

#: js/definition-list-blocks.js:105
msgid "Enter the term (dt)."
msgstr "dt タグの内容を入力"

#: js/definition-list-blocks.js:106
msgid "Enter the description (dd)."
msgstr "dd タグの内容を入力"

#: js/style-blocks.js:7
msgid "No marker"
msgstr "リストスタイルなし"

#: js/style-blocks.js:12
msgid "Open circle"
msgstr "単純白丸"

#: js/style-blocks.js:17
msgid "Large open circle"
msgstr "大きい白丸"

#: js/style-blocks.js:22
msgid "Numbers with reference mark"
msgstr "米印付数字"

#: js/style-blocks.js:27
msgid "Numbers in parentheses"
msgstr "括弧付き数字"

#: js/style-blocks.js:32
msgid "Circled numbers"
msgstr "白丸付き数字"

#: js/style-blocks.js:37
msgid "Sub-numbers (hyphen)"
msgstr "サブ番号（ハイフン）"

#: blocks/definition-details-html/block.json
msgctxt "block title"
msgid "DD Tag (Use HTML)"
msgstr "DD タグ（HTML 使用）"

#: blocks/definition-details-html/block.json
msgctxt "block description"
msgid "Add a dd tag that can contain blocks inside the dl tag."
msgstr "dl タグの中に、ブロックを入れられる dd タグを追加します。"

#: blocks/definition-details-html/block.json
#: blocks/definition-details/block.json
#: blocks/definition-div/block.json
#: blocks/definition-list/block.json
#: blocks/definition-term/block.json
msgctxt "block keyword"
msgid "definition list"
msgstr "定義リスト"

#: blocks/definition-details-html/block.json
#: blocks/definition-details/block.json
msgctxt "block keyword"
msgid "dd"
msgstr ""

#: blocks/definition-details/block.json
msgctxt "block title"
msgid "DD Tag"
msgstr "DD タグ"

#: blocks/definition-details/block.json
msgctxt "block description"
msgid "Add a dd tag inside the dl tag."
msgstr "dl タグの中に dd タグを追加します。"

#: blocks/definition-div/block.json
msgctxt "block title"
msgid "DIV Tag"
msgstr "DIV タグ"

#: blocks/definition-div/block.json
msgctxt "block description"
msgid "Add a div tag inside the dl tag."
msgstr "dl タグの中に div タグを追加します。"

#: blocks/definition-div/block.json
msgctxt "block keyword"
msgid "div"
msgstr ""

#: blocks/definition-list/block.json
msgctxt "block title"
msgid "DL Tag"
msgstr "DL タグ"

#: blocks/definition-list/block.json
msgctxt "block description"
msgid "dl tag. You can add dt, dd, or div tags inside."
msgstr "dl タグ。中に dt タグ、dd タグ、div タグを追加できます。"

#: blocks/definition-list/block.json
msgctxt "block keyword"
msgid "dl"
msgstr ""

#: blocks/definition-term/block.json
msgctxt "block title"
msgid "DT Tag"
msgstr "DT タグ"

#: blocks/definition-term/block.json
msgctxt "block description"
msgid "Add a dt tag inside the dl tag."
msgstr "dl タグの中に dt タグを追加します。"

#: blocks/definition-term/block.json
msgctxt "block keyword"
msgid "dt"
msgstr ""
